{
  "entities": {
    "Waterbody": {
      "title": "Waterbody",
      "description": "An Indian waterbody directory record or traditional water-body terminology entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "alternative_names": {
          "type": "array",
          "description": "Alternative, historical, or regional spellings (max 10)."
        },
        "entry_type": {
          "type": "string",
          "enum": ["named_waterbody", "traditional_term"]
        },
        "waterbody_category": {
          "type": "string",
          "enum": [
            "Natural lake",
            "Natural pond",
            "Village pond",
            "Reservoir",
            "Wetland",
            "Temple pond",
            "Agricultural pond",
            "Irrigation tank",
            "Traditional water structure",
            "Other or unverified waterbody"
          ]
        },
        "state": {
          "type": "string",
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "maxLength": 80
        },
        "country": {
          "type": "string",
          "maxLength": 40
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "historical_area": {
          "type": "number"
        },
        "recent_area": {
          "type": "number"
        },
        "estimated_area_loss": {
          "type": "number"
        },
        "monitoring_status": {
          "type": "string",
          "enum": [
            "Stable",
            "Watch",
            "Moderate Loss",
            "Severe Recession",
            "Low Confidence",
            "Unmonitored",
            "Terminology Only"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "Verified",
            "Partially Verified",
            "Unverified",
            "Terminology Record"
          ]
        },
        "data_source": {
          "type": "string",
          "maxLength": 120
        },
        "historicalPeriod": {
          "type": "string",
          "maxLength": 60
        },
        "recentPeriod": {
          "type": "string",
          "maxLength": 60
        },
        "resolutionNote": {
          "type": "string",
          "maxLength": 360
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "alternative_names",
        "entry_type",
        "waterbody_category",
        "state",
        "district",
        "country",
        "latitude",
        "longitude",
        "historical_area",
        "recent_area",
        "estimated_area_loss",
        "monitoring_status",
        "verification_status",
        "data_source",
        "historicalPeriod",
        "recentPeriod",
        "resolutionNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonitoringObservation": {
      "title": "MonitoringObservation",
      "description": "A periodic satellite or field water-extent observation for a monitored waterbody.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "waterbodyId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "waterbodyName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "observationDate": {
          "type": "string",
          "maxLength": 32
        },
        "season": {
          "type": "string",
          "enum": ["Pre-Monsoon", "Monsoon", "Post-Monsoon", "Winter"]
        },
        "sensorSource": {
          "type": "string",
          "enum": ["Sentinel-2 Optical (Demo)", "Sentinel-1 SAR (Demo)", "JRC Historical (Demo)", "Field Log"]
        },
        "observedAreaHa": {
          "type": "number"
        },
        "ndwiMean": {
          "type": "number"
        },
        "cloudCoverPct": {
          "type": "number"
        },
        "isHistoricalBaseline": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "waterbodyId",
        "waterbodyName",
        "observationDate",
        "season",
        "sensorSource",
        "observedAreaHa",
        "ndwiMean",
        "cloudCoverPct",
        "isHistoricalBaseline",
        "notes",
        "createdAt"
      ]
    },
    "DroughtAlert": {
      "title": "DroughtAlert",
      "description": "Preliminary water-loss monitoring alert (not an official government drought declaration).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "waterbodyId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "waterbodyName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "state": {
          "type": "string",
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "maxLength": 80
        },
        "severity": {
          "type": "string",
          "enum": ["Low", "Moderate", "High", "Critical"]
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Acknowledged", "Resolved"]
        },
        "estimatedLossPct": {
          "type": "number"
        },
        "seasonalComparisonNote": {
          "type": "string",
          "maxLength": 400
        },
        "disclaimer": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "waterbodyId",
        "waterbodyName",
        "state",
        "district",
        "severity",
        "status",
        "estimatedLossPct",
        "seasonalComparisonNote",
        "disclaimer",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated researcher profile and workspace preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "organization": {
          "type": "string",
          "maxLength": 120
        },
        "preferredState": {
          "type": "string",
          "maxLength": 80
        },
        "demoSeeded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "organization",
        "preferredState",
        "demoSeeded",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/waterbodies/{waterbodyId}": {
      "schema": {
        "$ref": "#/entities/Waterbody"
      },
      "description": "India Waterbody Directory entries and traditional water-body terminology records scoped by ownerId."
    },
    "/monitoringObservations/{observationId}": {
      "schema": {
        "$ref": "#/entities/MonitoringObservation"
      },
      "description": "Historical and recent monitoring observations linked to a waterbodyId."
    },
    "/alerts/{alertId}": {
      "schema": {
        "$ref": "#/entities/DroughtAlert"
      },
      "description": "Preliminary water-loss monitoring alerts linked to a waterbodyId."
    },
    "/userProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-isolated user profiles containing PII."
    }
  }
}
